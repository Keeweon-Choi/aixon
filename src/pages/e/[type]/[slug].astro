---
import Base from '../../../layouts/Base.astro'; import { getGraph, claimPath, entityPath } from '../../../lib/graph'; import { url, nodeAnchor } from '../../../lib/url'; import GraphView from '../../../islands/GraphView';
const g=getGraph(); export function getStaticPaths(){return Object.entries(g.entities).filter(([id])=>!['clm','src'].includes(id.split(':')[0])).map(([id,entity])=>({params:{type:id.split(':')[0],slug:id.split(':')[1]},props:{entity,id}}));} const {entity,id}=Astro.props; const slug=id.split(':')[1]; const claims=[...(g.claimsBySubject[id]||[]),...(g.claimsByObject[id]||[])];
---
<Base title={`${entity.name||entity.title} | AIXON`} description={entity.summary||`${entity.name||entity.title} 상세`}><article><h1>{entity.name||entity.title}</h1><p>{entity.summary || '준비 중'}</p><p><span class="badge">{entity.status||'active'}</span></p>{g.types[id] !== 'ResearchField' && <p><a href={url(`wiki/${slug}/`)}>Wiki 읽기</a> · <a href={`${url('atlas/')}#${nodeAnchor(id)}`}>그래프에서 보기</a></p>}<h2>관계</h2><ul>{claims.map((c:any)=><li><a href={url(claimPath(c.id))}>{c.predicate}</a> · {c.status}</li>)}</ul><GraphView client:visible mode="local" focus={id} /></article></Base>
