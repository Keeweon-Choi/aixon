---
import fs from 'node:fs';
import Base from '../../../layouts/Base.astro';
import { getGraph, claimPath, publicSummary } from '../../../lib/graph';
import { url, nodeAnchor } from '../../../lib/url';
import GraphView from '../../../islands/GraphView';
const g = getGraph();
export function getStaticPaths() {
  const graph = getGraph();
  return Object.entries(graph.entities)
    .filter(([id]) => !['clm', 'src'].includes(id.split(':')[0]))
    .map(([id, entity]) => ({
      params: { type: id.split(':')[0], slug: id.split(':')[1] },
      props: { entity, id },
    }));
}
const { entity, id } = Astro.props;
const slug = id.split(':')[1];
const claims = [...(g.claimsBySubject[id] || []), ...(g.claimsByObject[id] || [])];
---

<Base title={`${entity.name || entity.title} | AIXON`} description={publicSummary(entity, g.build)}>
  <article>
    <h1>{entity.name || entity.title}</h1>
    <p>{publicSummary(entity, g.build)}</p>
    <p>
      <span class="badge">{entity.status || 'active'}</span>
    </p>
    {g.types[id] !== 'ResearchField' && (
      <p>
        {g.build !== 'public' &&
          fs.existsSync(`${process.env.AIXON_WIKI_DIR || 'src/content/wiki'}/${slug}.mdx`) && (
            <>
              <a href={url(`wiki/${slug}/`)}>Wiki 읽기</a> ·{' '}
            </>
          )}
        <a href={`${url('atlas/')}#${nodeAnchor(id)}`}>그래프에서 보기</a>
      </p>
    )}
    <h2>관계</h2>
    <ul>
      {claims.map((c: any) => (
        <li>
          <a href={url(claimPath(c.id))}>{c.predicate}</a> · {c.status}
        </li>
      ))}
    </ul>
    <GraphView client:visible mode="local" focus={id} />
  </article>
</Base>
