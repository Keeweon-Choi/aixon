---
import Base from '../../layouts/Base.astro';
import ClaimBadges from '../../components/ClaimBadges.astro';
import { claimStatusLabel, confidenceLabel } from '../../lib/badges';
import { entityPath, getGraph } from '../../lib/graph';
import { claimSentence, predicateDescription, predicateName } from '../../lib/predicates';
import { url } from '../../lib/url';
const graph = getGraph();
export function getStaticPaths() {
  const current = getGraph();
  return Object.entries(current.emittedClaims).map(([id, claim]) => ({
    params: { slug: id.replace(/^clm:/, '') },
    props: { claim },
  }));
}
const { claim } = Astro.props;
const name = (id: string) => String(graph.entities[id]?.name || graph.entities[id]?.title || id);
const sentence = claimSentence(claim, name);
const evidence = Array.isArray(claim.evidence) ? claim.evidence : [];
const qualifierLabels: Record<string, string> = {
  for_dimension: '학습 차원',
  benchmark: '벤치마크',
  metric: '지표',
  conditions: '조건',
  value: '값',
  baseline_value: '기준값',
  from_field: '출발 분야',
  to_field: '도착 분야',
  stage: '단계',
  summary: '요약',
  required_dimension: '요구 차원',
  subject_value: '주체 수치',
  object_value: '대상 수치',
  subject_variant: '주체 변형',
  object_variant: '대상 변형',
};
const qualifierValue = (key: string, value: unknown) =>
  ['from_field', 'to_field'].includes(key) && typeof value === 'string'
    ? name(value)
    : typeof value === 'string'
      ? value
      : JSON.stringify(value);
const sourceHref = (item: Record<string, unknown>) => {
  const source = graph.sources[String(item.source)];
  const base = String(source?.fulltext_url || source?.url || '');
  const fragment = String(item.quote || item.rationale || '')
    .split(/\s+/)
    .filter(Boolean)
    .slice(0, 8)
    .join(' ');
  return base ? `${base}#:~:text=${encodeURIComponent(fragment)}` : '';
};
---

<Base title={`${sentence} | AIXON`} description={sentence}>
  <article>
    <h1>{sentence}</h1>
    <section data-testid="claim-status">
      <p>
        {claimStatusLabel(claim.status)} · 신뢰도: {confidenceLabel(claim.confidence)}
      </p>
      <ClaimBadges claim={claim} publicBuild={graph.build === 'public'} />
    </section>
    <h2>술어</h2>
    <p>
      {predicateName(String(claim.predicate))} ({String(claim.predicate)}):{' '}
      {predicateDescription[String(claim.predicate)] || '관계 정의가 아직 없습니다.'}
    </p>
    {claim.qualifiers && (
      <section>
        <h2>한정 조건</h2>
        <dl>
          {Object.entries(claim.qualifiers).map(([key, value]) => (
            <>
              <dt>{qualifierLabels[key] || key}</dt>
              <dd>{qualifierValue(key, value)}</dd>
            </>
          ))}
        </dl>
      </section>
    )}
    {['rejected', 'deprecated'].includes(String(claim.status)) && (
      <p class="banner">
        {claimStatusLabel(claim.status)} ·{' '}
        {String(
          claim.rejected_reason ||
            claim.reason ||
            claim.deprecation_reason ||
            claim.note ||
            '사유가 기록되지 않았습니다.',
        )}
      </p>
    )}
    {claim.note && <p>큐레이터 메모: {String(claim.note)}</p>}
    <section data-testid="evidence">
      <h2>근거</h2>
      {evidence.map((item) => {
        const source = graph.sources[String(item.source)];
        const href = sourceHref(item);
        return (
          <section data-stance={String(item.stance || 'supports')}>
            <h3>
              {item.stance === 'contradicts'
                ? '반대 근거'
                : item.stance === 'qualifies'
                  ? '조건부 근거'
                  : '지지 근거'}
            </h3>
            <blockquote lang="en">{String(item.quote || item.rationale || '')}</blockquote>
            <p data-testid="locator">
              위치:{' '}
              {item.locator
                ? Object.entries(item.locator)
                    .map(([key, value]) => `${key} ${value}`)
                    .join(', ')
                : '미지정'}
            </p>
            <p>근거 유형: {String(item.type || item.evidence_type || '미지정')}</p>
            {source && (
              <p>
                {String(source.title || source.name || item.source)}{' '}
                {source.version && `· ${source.version}`} {source.year && `· ${source.year}`}
              </p>
            )}
            {href && (
              <a data-testid="source-link" rel="noopener noreferrer" href={href}>
                원문에서 보기
              </a>
            )}
          </section>
        );
      })}
    </section>
    <p>
      <a href={url(entityPath(String(claim.subject), graph))}>주체 보기</a> ·{' '}
      <a href={url(entityPath(String(claim.object), graph))}>대상 보기</a>
    </p>
  </article>
</Base>
