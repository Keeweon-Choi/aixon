---
import { getCollection, render } from 'astro:content'; import Base from '../../layouts/Base.astro';
import Section from '../../components/wiki/Section.astro'; import Level from '../../components/wiki/Level.astro'; import ConceptLink from '../../components/wiki/ConceptLink.astro'; import Cite from '../../components/wiki/Cite.astro'; import Callout from '../../components/wiki/Callout.astro'; import Figure from '../../components/wiki/Figure.astro'; import SoftmaxTemperatureLab from '../../islands/SoftmaxTemperatureLab';
import { getGraph, claimPath, entityPath } from '../../lib/graph'; import { url } from '../../lib/url';
interface Props { entry: any }
export async function getStaticPaths() { return (await getCollection('wiki')).filter(x => import.meta.env.AIXON_BUILD !== 'public' || x.data.status === 'published').map(entry => ({ params: { slug: entry.id }, props: { entry } })); }
const entry = Astro.props.entry; const { Content } = await render(entry); const graph = getGraph(); const cited = [...entry.data.sources, ...entry.data.claims];
const related = Object.values(graph.claims).filter((c: any) => (c.subject === entry.data.entity || c.object === entry.data.entity) && ['PREREQUISITE_OF','RECOMMENDED_BEFORE','PART_OF','IS_A'].includes(c.predicate as string));
---
<Base title={`${entry.data.title} | AIXON`} description={entry.data.subtitle}>
<article><h1>{entry.data.title}</h1><p>{entry.data.subtitle}</p>{entry.data.status === 'draft' && <p class="banner">검토 전 초안 · {entry.data.ai_generated ? 'AI 작성' : '작성 중'}</p>}
<nav class="toc" aria-label="목차">{entry.data.sections.map(x => <a href={`#${x}`}>{x}</a>)}</nav><fieldset><legend>표시 수준</legend>{[['intuition','직관'],['fundamentals','기초'],['deep','심화']].map(([v,n]) => <label><input type="radio" name="wiki-level" value={v} checked={v === 'fundamentals'} />{n}</label>)}</fieldset>
<Content components={{ Section, Level, ConceptLink, Cite, Callout, Figure, SoftmaxTemperatureLab }} />
<section><h2>관련 개념</h2><ul>{related.map((c: any) => <li><a href={url(entityPath(c.subject === entry.data.entity ? c.object : c.subject, graph))}>{String(c.predicate)} · {c.subject === entry.data.entity ? c.object : c.subject}</a></li>)}</ul></section>
<section><h2>참고문헌과 근거</h2><ul>{cited.map(id => <li>{id.startsWith('clm:') ? <a href={url(claimPath(id))}>{id}</a> : <a href={String(graph.sources[id]?.url)}>{graph.sources[id]?.name || id}</a>}</li>)}</ul></section>
</article>
<script>const rank:Record<string,number>={intuition:0,fundamentals:1,deep:2};document.querySelectorAll<HTMLInputElement>('[name="wiki-level"]').forEach(i=>i.addEventListener('change',()=>{const n=rank[i.value];document.querySelectorAll<HTMLElement>('[data-level]').forEach(x=>x.hidden=(rank[x.dataset.level || 'deep'] ?? 2)>n)}));</script>
</Base>
