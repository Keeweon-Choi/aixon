---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Callout from '../../components/wiki/Callout.astro';
import Cite from '../../components/wiki/Cite.astro';
import ConceptLink from '../../components/wiki/ConceptLink.astro';
import Figure from '../../components/wiki/Figure.astro';
import Lab from '../../components/wiki/Lab.astro';
import Level from '../../components/wiki/Level.astro';
import Section from '../../components/wiki/Section.astro';
import { claimPath, entityPath, getGraph, sourceLabel } from '../../lib/graph';
import { claimSentence } from '../../lib/predicates';
import { dimensionLabels, reviewLabel } from '../../lib/badges';
import { nodeAnchor, url } from '../../lib/url';
const graph = getGraph();
interface Props {
  entry: any;
}
const sectionTitles: Record<string, string> = {
  overview: '개요와 직관',
  why: '왜 중요한가',
  mechanism: '핵심 작동 원리',
  math: '수학적 기초',
  example: '단계별 예제',
  code: '구현',
  visual: '시각적 설명',
  limitations: '한계와 트레이드오프',
  history: '역사적 발전',
  related: '관련 개념',
  references: '참고문헌과 근거',
};
export async function getStaticPaths() {
  const current = getGraph();
  return (await getCollection('wiki'))
    .filter((entry) => current.isVisible('wiki', entry.data.id))
    .map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const entry: any = Astro.props.entry;
const { Content } = await render(entry);
const E = String(entry.data.entity);
// Only verified claims whose other end is visible; direction decides the group (docs/02 section 6).
const relatedClaims = Object.values(graph.claims).filter(
  (claim) =>
    claim.status === 'verified' &&
    graph.isVisible('entity', String(claim.subject)) &&
    graph.isVisible('entity', String(claim.object)),
);
const into = (predicates: string[]) =>
  relatedClaims.filter(
    (claim) => claim.object === E && predicates.includes(String(claim.predicate)),
  );
const outOf = (predicates: string[]) =>
  relatedClaims.filter(
    (claim) => claim.subject === E && predicates.includes(String(claim.predicate)),
  );
const prerequisiteClaims = into(['PREREQUISITE_OF', 'RECOMMENDED_BEFORE']);
const prerequisiteGroups = Object.entries(
  Object.groupBy(prerequisiteClaims, (claim) =>
    String((claim.qualifiers as Record<string, unknown> | undefined)?.for_dimension || 'explain'),
  ),
);
const relatedGroups = [
  [
    'related-dependents',
    '이 개념을 바탕으로 하는 개념',
    outOf(['PREREQUISITE_OF', 'RECOMMENDED_BEFORE']),
    'object',
  ],
  ['related-parts', '구성 요소', into(['PART_OF']), 'subject'],
  ['related-wholes', '이것이 들어가는 구조', outOf(['PART_OF']), 'object'],
  ['related-subtypes', '하위 개념', into(['IS_A']), 'subject'],
  ['related-supertypes', '상위 개념', outOf(['IS_A']), 'object'],
] as const;
const displayName = (id: string) =>
  String(graph.entities[id]?.name || graph.entities[id]?.title || id);
const references = [
  ...entry.data.sources.filter((id) => graph.isVisible('source', id)),
  ...entry.data.claims.filter((id) => graph.isVisible('claim', id)),
];
const review = entry.data.review;
---

<Base title={`${entry.data.title} | AIXON`} description={entry.data.subtitle}>
  <Fragment slot="head">
    <script is:inline>
      try {
        document.documentElement.dataset.level =
          localStorage.getItem('aixon-wiki-level') || 'fundamentals';
      } catch {
        document.documentElement.dataset.level = 'fundamentals';
      }
    </script>
  </Fragment>
  <article>
    <h1>{entry.data.title}</h1>
    <p>{entry.data.subtitle}</p>
    <p>
      <a data-testid="wiki-entity-link" href={url(entityPath(E, graph))}>
        개념 페이지
      </a>{' '}
      ·{' '}
      <a data-testid="wiki-atlas-link" href={`${url('atlas/')}#${nodeAnchor(E)}`}>
        아틀라스에서 보기
      </a>
    </p>
    {['outline', 'draft'].includes(entry.data.status) && (
      <p data-testid="status-banner" class="banner">
        검토 전 초안 · {entry.data.ai_generated ? 'AI 작성' : '작성 중'}
      </p>
    )}
    {['reviewed', 'published'].includes(entry.data.status) && (
      <p data-testid="status-banner" class="banner">
        {reviewLabel({ review: review && { ...review, at: review.at?.toISOString().slice(0, 10) } })}
      </p>
    )}
    <nav class="toc" aria-label="목차">
      {entry.data.sections.map((section) => (
        <a href={`#${section}`}>{sectionTitles[section] || section}</a>
      ))}
    </nav>
    <fieldset>
      <legend>표시 수준</legend>
      {[
        ['intuition', '직관'],
        ['fundamentals', '기초'],
        ['deep', '심화'],
      ].map(([value, label]) => (
        <label>
          <input type="radio" name="wiki-level" value={value} checked={value === 'fundamentals'} />
          {label}
        </label>
      ))}
    </fieldset>
    <Content components={{ Section, Level, ConceptLink, Cite, Callout, Figure, Lab }} />
    <section data-testid="related">
      <h2>관련 개념</h2>
      {prerequisiteClaims.length > 0 && (
        <section data-testid="related-prerequisites">
          <h3>먼저 알아야 할 개념</h3>
          {prerequisiteGroups.map(([dimension, rows]) => (
            <>
              <h4>{dimensionLabels[dimension] || dimension}</h4>
              <ul>
                {rows?.map((claim) => (
                  <li data-node-id={String(claim.subject)} data-predicate={String(claim.predicate)}>
                    <a href={url(entityPath(String(claim.subject), graph))}>
                      {displayName(String(claim.subject))}
                    </a>
                    {claim.predicate === 'RECOMMENDED_BEFORE' && ' · 권장'}
                  </li>
                ))}
              </ul>
            </>
          ))}
        </section>
      )}
      {relatedGroups
        .filter(([, , rows]) => rows.length > 0)
        .map(([testid, label, rows, end]) => (
          <section data-testid={testid}>
            <h3>{label}</h3>
            <ul>
              {rows.map((claim) => (
                <li data-node-id={String(claim[end])} data-predicate={String(claim.predicate)}>
                  <a href={url(entityPath(String(claim[end]), graph))}>
                    {displayName(String(claim[end]))}
                  </a>
                  {claim.predicate === 'RECOMMENDED_BEFORE' && ' · 권장'}
                </li>
              ))}
            </ul>
          </section>
        ))}
    </section>
    <section data-testid="references">
      <h2>참고문헌과 근거</h2>
      <ol>
        {references.map((id, index) => (
          <li id={`ref-${index + 1}`}>
            {id.startsWith('clm:') ? (
              <a href={url(claimPath(id))}>
                {claimSentence(graph.claims[id] ?? graph.emittedClaims[id], displayName)}
              </a>
            ) : (
              <a rel="noopener noreferrer" href={String(graph.sources[id]?.url || '#')}>
                {sourceLabel(graph, id)}
              </a>
            )}
          </li>
        ))}
      </ol>
    </section>
  </article>
  <script>
    const radios = document.querySelectorAll<HTMLInputElement>('[name="wiki-level"]');
    const selected = document.documentElement.dataset.level || 'fundamentals';
    radios.forEach((radio) => {
      radio.checked = radio.value === selected;
      radio.addEventListener('change', () => {
        if (!radio.checked) return;
        document.documentElement.dataset.level = radio.value;
        try {
          localStorage.setItem('aixon-wiki-level', radio.value);
        } catch {}
      });
    });
  </script>
</Base>
