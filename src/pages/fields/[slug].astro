---
import Base from '../../layouts/Base.astro';
import { entityTypeLabels } from '../../lib/badges';
import { entityPath, getGraph } from '../../lib/graph';
import { nodeAnchor, url } from '../../lib/url';
const graph = getGraph();
export function getStaticPaths() {
  const current = getGraph();
  return Object.values(current.fields).map((field) => ({
    params: { slug: String(field.id).split(':')[1] },
    props: { field },
  }));
}
const { field } = Astro.props;
const children = Object.values(graph.fields).filter((candidate) =>
  graph.parents[String(candidate.id)]?.includes(String(field.id)),
);
const members = graph.memberships[String(field.id)] || [];
const byType = Object.groupBy(members, (id) => graph.types[id]);
---

<Base title={`${field.name} | AIXON`} description={String(field.summary || `${field.name} 분야`)}>
  <article>
    <h1>{field.name}</h1>
    <p>{field.summary}</p>
    {graph.parents[String(field.id)]?.length > 0 && (
      <p>
        상위 분야:{' '}
        {graph.parents[String(field.id)].map((parent, index) => (
          <>
            {index > 0 && ' › '}
            <a href={url(entityPath(parent, graph))}>
              {String(graph.fields[parent]?.name || parent)}
            </a>
          </>
        ))}
      </p>
    )}
    <p>
      <a href={`${url('atlas/')}#${nodeAnchor(String(field.id))}`}>아틀라스에서 이 분야 보기</a>
    </p>
    <section>
      <h2>하위 분야</h2>
      <ul>
        {children.map((child) => (
          <li>
            <a href={url(entityPath(String(child.id), graph))}>{String(child.name)}</a>
          </li>
        ))}
      </ul>
    </section>
    <section>
      <h2>소속 개념</h2>
      {Object.entries(byType).map(([type, ids]) => (
        <section>
          <h3>{entityTypeLabels[type] || type}</h3>
          <ul>
            {ids?.map((id) => (
              <li>
                <a href={url(entityPath(id, graph))}>
                  {String(graph.entities[id]?.name || graph.entities[id]?.title || id)}
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </section>
  </article>
</Base>
