---
import { getGraph, claimPath, sourceLabel } from '../../lib/graph';
import { claimSentence } from '../../lib/predicates';
import { url } from '../../lib/url';
const { src, claim, loc } = Astro.props;
const graph = getGraph();
const id = src || claim;
if (!id) throw new Error('Cite needs src or claim');
const visible = claim ? graph.isVisible('claim', claim) : graph.isVisible('source', src);
const name = (entityId: string) =>
  String(graph.entities[entityId]?.name || graph.entities[entityId]?.title || entityId);
const label = claim
  ? graph.emittedClaims[claim]
    ? claimSentence(graph.emittedClaims[claim], name)
    : '검토 대기 중인 근거'
  : sourceLabel(graph, src);
const target = claim ? url(claimPath(claim)) : String(graph.sources[src]?.url || '#');
---

<sup class="cite">
  {visible ? (
    <a href={target} title={loc}>
      [{label}]
    </a>
  ) : (
    <span title={loc}>[{label}] (검토 대기)</span>
  )}
</sup>
