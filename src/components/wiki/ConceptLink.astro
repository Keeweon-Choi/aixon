---
import { getGraph, entityPath } from '../../lib/graph';
import { url } from '../../lib/url';
const { id } = Astro.props;
const graph = getGraph();
if (!graph.allEntities[id]) throw new Error(`Unknown ConceptLink: ${id}`);
const slug = String(id).split(':')[1];
const wiki = graph.wikiFor(id);
---

{graph.isVisible('entity', id) ? (
  <a data-concept-id={id} href={url(wiki ? `wiki/${slug}/` : entityPath(id, graph))}>
    <slot />
  </a>
) : (
  <slot />
)}
